{
    "name": "theia-sticky-sidebar",
    "version": "2.0.0",
    "description": "Glues your website's sidebars, making them permanently visible while scrolling.",
    "authors": [
        "Liviu Mirea <liviu.mirea@wecodepixels.com>"
    ],
    "license": "MIT",
    "main": "./dist/theia-sticky-sidebar.umd.cjs",
    "module": "./dist/theia-sticky-sidebar.es.js",
    "types": "./dist/theia-sticky-sidebar.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/theia-sticky-sidebar.d.ts",
                "default": "./dist/theia-sticky-sidebar.es.js"
            },
            "require": {
                "types": "./dist/theia-sticky-sidebar.d.cts",
                "default": "./dist/theia-sticky-sidebar.umd.cjs"
            },
            "default": "./dist/theia-sticky-sidebar.es.js"
        },
        "./dist/theia-sticky-sidebar": {
            "import": {
                "types": "./dist/theia-sticky-sidebar.d.ts",
                "default": "./dist/theia-sticky-sidebar.es.js"
            },
            "require": {
                "types": "./dist/theia-sticky-sidebar.d.cts",
                "default": "./dist/theia-sticky-sidebar.umd.cjs"
            },
            "default": "./dist/theia-sticky-sidebar.es.js"
        },
        "./dist/theia-sticky-sidebar.umd.js": null,
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "files": [
        "/dist",
        "/package.json",
        "/README.md",
        "/LICENSE.txt",
        "/CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/WeCodePixels/theia-sticky-sidebar.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && npm run build:cjs-types && npm run build:umd-alias",
        "build:cjs-types": "node -e \"require('fs').copyFileSync('dist/theia-sticky-sidebar.d.ts', 'dist/theia-sticky-sidebar.d.cts')\"",
        "build:umd-alias": "node -e \"require('fs').copyFileSync('dist/theia-sticky-sidebar.umd.cjs', 'dist/theia-sticky-sidebar.umd.js')\"",
        "prepublishOnly": "npm run build",
        "lint": "eslint lib",
        "lint:fix": "eslint --fix lib"
    },
    "devDependencies": {
        "@eslint/js": "^9.24.0",
        "@playwright/test": "^1.51.1",
        "@types/node": "^22.14.0",
        "eslint": "^9.24.0",
        "nyc": "^17.1.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.29.0",
        "vite": "^6.2.5",
        "vite-plugin-dts": "^4.5.3",
        "vite-plugin-istanbul": "^7.0.0"
    }
}
